{
  "name": "robotsix-board-js-lint",
  "private": true,
  "description": "JS lint tooling for robotsix-board static assets (no runtime JS deps).",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint:js": "eslint src/robotsix_board/static/board.js",
    "lint:css": "stylelint src/robotsix_board/static/board.css",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules' '#.venv' '#changes'",
    "test:js": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "eslint": "^9",
    "@eslint/js": "^9",
    "globals": "^17",
    "stylelint": "^17",
    "stylelint-config-standard": "^40",
    "@vitest/eslint-plugin": "^1",
    "eslint-plugin-jsdoc": "^63",
    "happy-dom": "^20",
    "vitest": "^4",
    "@vitest/coverage-v8": "^4",
    "markdownlint-cli2": "^0.22",
    "typescript": "^6.0"
  }
}
