{
  "name": "robotsix-board-js-lint",
  "private": true,
  "description": "JS lint tooling for robotsix-board static assets (no runtime JS deps).",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "lint:js": "eslint --max-warnings 0 src/robotsix_board/static/board.js",
    "lint:css": "stylelint src/robotsix_board/static/board.css",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules' '#.venv' '#changelog.d'",
    "test:js": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "cosmiconfig": {
      "js-yaml": ">=4.3.0 <5.0.0"
    },
    "markdownlint-cli2": {
      "js-yaml": ">=5.2.1 <6.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@vitest/coverage-v8": "^4",
    "@vitest/eslint-plugin": "^1",
    "eslint": "^10.7.0",
    "eslint-plugin-jsdoc": "^63.0.13",
    "globals": "^17",
    "happy-dom": "^20",
    "markdownlint-cli2": "^0.23.0",
    "stylelint": "^17",
    "stylelint-config-standard": "^40",
    "typescript": "^7.0",
    "vitest": "^4"
  }
}
